# Gym & Leno Environment Configuration

# Admin Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
AUTH_SECRET=gym-leno-super-secret-salt-2026

# Supabase Storage & Database Integration (Optional)
# If provided, the app connects directly to Supabase cloud PostgreSQL & Storage buckets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production Domain URL
NEXT_PUBLIC_SITE_URL=https://gym-leno.vercel.app
